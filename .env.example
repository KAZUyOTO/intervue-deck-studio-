# Figma personal access token (Figma → Settings → Security → Personal access tokens, scope: file content read)
FIGMA_TOKEN=

# The deck file. Paste the full Figma URL or just the file key.
# Decks in separate files: put every link here, separated by commas.
FIGMA_FILE_URL=

# Passcode the designer types to press "Sync from Figma". Leave empty to allow anyone with the link.
ADMIN_KEY=

# Added automatically when you connect a Vercel Blob store to the project.
# Without it (local dev) files are stored in the .data folder.
BLOB_READ_WRITE_TOKEN=

# Cloudflare R2 (used instead of Vercel Blob when all five are set).
# R2 → your bucket → Settings: turn on Public Development URL (r2.dev) and paste it as R2_PUBLIC_URL.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
